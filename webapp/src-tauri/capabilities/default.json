{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions, the file-save path the app needs to export a report or a backup, and outbound HTTP to Yahoo Finance and nowhere else.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "dialog:allow-message",
    "fs:allow-write-file",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://query1.finance.yahoo.com/*"
        }
      ]
    }
  ]
}
