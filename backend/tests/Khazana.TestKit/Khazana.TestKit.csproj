<Project Sdk="Microsoft.NET.Sdk">
  <!-- What a real app does, for tests: a device key that signs DPoP proofs,
       and a software passkey authenticator. Shared by every service's tests. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA2007;CA1062</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="System.Formats.Cbor" />
  </ItemGroup>
</Project>
