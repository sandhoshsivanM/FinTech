<Project>
  <!-- Central package management: every version is pinned here, once. A
       project references a package by name only, so two services can never
       drift onto different versions of the same library. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Pins transitive dependencies too. Without it, Npgsql's EF provider
         pulled in EF Core 10.0.4 while the design-time package wanted 10.0.13,
         and the test projects loaded two versions of the same assembly. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Aspire -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.3" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.3" />
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="13.6.3" />
    <!-- Service defaults -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery.Yarp" Version="10.11.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
    <!-- Gateway -->
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <!-- Messaging (decision D14: Wolverine, MIT) -->
    <PackageVersion Include="WolverineFx" Version="6.51.2" />
    <PackageVersion Include="WolverineFx.EntityFrameworkCore" Version="6.51.2" />
    <PackageVersion Include="WolverineFx.Postgresql" Version="6.51.2" />
    <PackageVersion Include="WolverineFx.RabbitMQ" Version="6.51.2" />
    <!-- Compiles handler code at startup. Fine locally; production should
         switch to pre-generated static code (no Roslyn in the image). -->
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.51.2" />
    <!-- Identity and tokens. The IdentityModel packages move together: a
         mismatch between them fails at runtime, not at build. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <!-- Passkeys (WebAuthn), MIT. -->
    <PackageVersion Include="Fido2" Version="4.3.1" />
    <PackageVersion Include="Fido2.Models" Version="4.3.1" />
    <!-- Data -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.16.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <!-- Builds WebAuthn messages for the software authenticator in the tests. -->
    <PackageVersion Include="System.Formats.Cbor" Version="10.0.13" />
  </ItemGroup>
</Project>
