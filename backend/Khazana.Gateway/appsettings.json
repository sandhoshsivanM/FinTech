{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimits": {
    "Public": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "Auth": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "User": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    },
    "Global": {
      "PermitLimit": 1200,
      "WindowSeconds": 60
    }
  },
  "ReverseProxy": {
    "Routes": {
      "market": {
        "ClusterId": "marketdata",
        "RateLimiterPolicy": "public",
        "Match": {
          "Path": "/v1/market/{**rest}",
          "Methods": [
            "GET",
            "HEAD"
          ]
        }
      },
      "auth": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/v1/auth/{**rest}",
          "Methods": [
            "POST"
          ]
        }
      },
      "account": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/v1/account",
          "Methods": [
            "DELETE"
          ]
        }
      },
      "devices": {
        "ClusterId": "devices",
        "RateLimiterPolicy": "user",
        "Match": {
          "Path": "/v1/devices/{**rest}",
          "Methods": [
            "GET",
            "POST",
            "DELETE"
          ]
        }
      },
      "keys": {
        "ClusterId": "devices",
        "RateLimiterPolicy": "user",
        "Match": {
          "Path": "/v1/keys/{**rest}",
          "Methods": [
            "GET",
            "POST",
            "PUT"
          ]
        }
      },
      "sync": {
        "ClusterId": "sync",
        "RateLimiterPolicy": "user",
        "Match": {
          "Path": "/v1/sync/{**rest}",
          "Methods": [
            "GET",
            "POST"
          ]
        }
      },
      "push": {
        "ClusterId": "notification",
        "RateLimiterPolicy": "user",
        "Match": {
          "Path": "/v1/push/{**rest}",
          "Methods": [
            "POST",
            "DELETE"
          ]
        }
      },
      "sync-attachments": {
        "ClusterId": "sync",
        "RateLimiterPolicy": "user",
        "Order": -1,
        "Match": {
          "Path": "/v1/sync/attachments/{id}",
          "Methods": [
            "GET",
            "PUT",
            "DELETE"
          ]
        }
      }
    },
    "Clusters": {
      "marketdata": {
        "Destinations": {
          "primary": {
            "Address": "http://marketdata-api"
          }
        }
      },
      "identity": {
        "Destinations": {
          "primary": {
            "Address": "http://identity-api"
          }
        }
      },
      "devices": {
        "Destinations": {
          "primary": {
            "Address": "http://devices-api"
          }
        }
      },
      "sync": {
        "Destinations": {
          "primary": {
            "Address": "http://sync-api"
          }
        }
      },
      "notification": {
        "Destinations": {
          "primary": {
            "Address": "http://notification-api"
          }
        }
      }
    }
  },
  "Gateway": {
    "TrustedProxies": []
  }
}
