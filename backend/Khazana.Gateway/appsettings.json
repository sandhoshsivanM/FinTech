{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimits": {
    "Public": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "Auth": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "User": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    },
    "Global": {
      "PermitLimit": 1200,
      "WindowSeconds": 60
    },
    "Costly": {
      "PermitLimit": 10,
      "WindowSeconds": 3600
    }
  },
  "ReverseProxy": {
    "Routes": {
      "market": {
        "ClusterId": "marketdata",
        "RateLimiterPolicy": "public",
        "Match": {
          "Path": "/v1/market/{**rest}",
          "Methods": [
            "GET",
            "HEAD"
          ]
        }
      },
      "auth": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/v1/auth/{**rest}",
          "Methods": [
            "POST"
          ]
        }
      },
      "account": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/v1/account",
          "Methods": [
            "DELETE"
          ]
        }
      },
      "devices": {
        "ClusterId": "devices",
        "RateLimiterPolicy": "user",
        "Match": {
          "Path": "/v1/devices/{**rest}",
          "Methods": [
            "GET",
            "POST",
            "PATCH",
            "DELETE"
          ]
        }
      },
      "keys": {
        "ClusterId": "devices",
        "RateLimiterPolicy": "user",
        "Match": {
          "Path": "/v1/keys/{**rest}",
          "Methods": [
            "GET",
            "POST",
            "PUT"
          ]
        }
      },
      "sync": {
        "ClusterId": "sync",
        "RateLimiterPolicy": "user",
        "Match": {
          "Path": "/v1/sync/{**rest}",
          "Methods": [
            "GET",
            "POST"
          ]
        }
      },
      "push": {
        "ClusterId": "notification",
        "RateLimiterPolicy": "user",
        "Match": {
          "Path": "/v1/push/{**rest}",
          "Methods": [
            "POST",
            "DELETE"
          ]
        }
      },
      "sync-attachments": {
        "ClusterId": "sync",
        "RateLimiterPolicy": "user",
        "Order": -1,
        "Match": {
          "Path": "/v1/sync/attachments/{id}",
          "Methods": [
            "GET",
            "PUT",
            "DELETE"
          ]
        }
      },
      "catalog": {
        "ClusterId": "catalog",
        "RateLimiterPolicy": "public",
        "Match": {
          "Path": "/v1/catalog/{**rest}",
          "Methods": [
            "GET",
            "HEAD"
          ]
        }
      },
      "catalog-root": {
        "ClusterId": "catalog",
        "RateLimiterPolicy": "public",
        "Match": {
          "Path": "/v1/catalog",
          "Methods": [
            "GET",
            "HEAD"
          ]
        }
      },
      "account-restore": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/v1/account/restore",
          "Methods": [
            "POST"
          ]
        }
      },
      "aa": {
        "ClusterId": "aa",
        "RateLimiterPolicy": "user",
        "Match": {
          "Path": "/v1/aa/{**rest}",
          "Methods": [
            "GET",
            "POST",
            "DELETE"
          ]
        }
      },
      "aa-fetch": {
        "ClusterId": "aa",
        "RateLimiterPolicy": "costly",
        "Order": -1,
        "Match": {
          "Path": "/v1/aa/fetch",
          "Methods": [
            "POST"
          ]
        }
      },
      "aa-consent-create": {
        "ClusterId": "aa",
        "RateLimiterPolicy": "costly",
        "Order": -1,
        "Match": {
          "Path": "/v1/aa/consents",
          "Methods": [
            "POST"
          ]
        }
      },
      "aa-webhook": {
        "ClusterId": "aa",
        "RateLimiterPolicy": "public",
        "Match": {
          "Path": "/v1/webhooks/aa",
          "Methods": [
            "POST"
          ]
        }
      },
      "credit": {
        "ClusterId": "credit",
        "RateLimiterPolicy": "user",
        "Match": {
          "Path": "/v1/credit/{**rest}",
          "Methods": [
            "GET",
            "POST",
            "DELETE"
          ]
        }
      },
      "credit-report": {
        "ClusterId": "credit",
        "RateLimiterPolicy": "costly",
        "Order": -1,
        "Match": {
          "Path": "/v1/credit/report",
          "Methods": [
            "POST"
          ]
        }
      }
    },
    "Clusters": {
      "marketdata": {
        "Destinations": {
          "primary": {
            "Address": "http://marketdata-api"
          }
        }
      },
      "identity": {
        "Destinations": {
          "primary": {
            "Address": "http://identity-api"
          }
        }
      },
      "devices": {
        "Destinations": {
          "primary": {
            "Address": "http://devices-api"
          }
        }
      },
      "sync": {
        "Destinations": {
          "primary": {
            "Address": "http://sync-api"
          }
        }
      },
      "notification": {
        "Destinations": {
          "primary": {
            "Address": "http://notification-api"
          }
        }
      },
      "catalog": {
        "Destinations": {
          "primary": {
            "Address": "http://catalog-api"
          }
        }
      },
      "aa": {
        "Destinations": {
          "primary": {
            "Address": "http://aa-api"
          }
        }
      },
      "credit": {
        "Destinations": {
          "primary": {
            "Address": "http://credit-api"
          }
        }
      }
    }
  },
  "Gateway": {
    "TrustedProxies": [],
    "AllowedOrigins": []
  }
}
