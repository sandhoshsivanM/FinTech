{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimits": {
    "Public": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    }
  },
  "ReverseProxy": {
    "Routes": {
      "market": {
        "ClusterId": "marketdata",
        "RateLimiterPolicy": "public",
        "Match": {
          "Path": "/v1/market/{**rest}",
          "Methods": [ "GET", "HEAD" ]
        }
      }
    },
    "Clusters": {
      "marketdata": {
        "Destinations": {
          "primary": {
            "Address": "http://marketdata-api"
          }
        }
      }
    }
  }
}
