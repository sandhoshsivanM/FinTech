{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimits": {
    "Public": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "Auth": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "Global": {
      "PermitLimit": 1200,
      "WindowSeconds": 60
    }
  },
  "ReverseProxy": {
    "Routes": {
      "market": {
        "ClusterId": "marketdata",
        "RateLimiterPolicy": "public",
        "Match": {
          "Path": "/v1/market/{**rest}",
          "Methods": [
            "GET",
            "HEAD"
          ]
        }
      },
      "auth": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/v1/auth/{**rest}",
          "Methods": [
            "POST"
          ]
        }
      },
      "account": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/v1/account",
          "Methods": [
            "DELETE"
          ]
        }
      }
    },
    "Clusters": {
      "marketdata": {
        "Destinations": {
          "primary": {
            "Address": "http://marketdata-api"
          }
        }
      },
      "identity": {
        "Destinations": {
          "primary": {
            "Address": "http://identity-api"
          }
        }
      }
    }
  },
  "Gateway": {
    "TrustedProxies": []
  }
}
