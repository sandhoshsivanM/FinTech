# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Packaged release artifacts (rebuild with flutter build + hdiutil)
/dist/

# Golden-test failure output. Regenerated on every failing run; committing it
# means the repo carries a snapshot of one machine's font rendering.
/test/golden/failures/

# Local Netlify folder
.netlify

# Release binaries staged into the site for download. Rebuilt with
# `cd webapp && npx tauri build`, then copied to site/downloads/ — see
# site/README.md. Binaries do not belong in git: they are large, they change
# every release, and the repository would carry every past build forever.
/site/downloads/

# Generated by docs/case-study/build.sh into the site's deploy directory.
# Regenerating is one command, and a committed copy is a copy that goes stale
# silently — which for this file means publishing the appendices it exists to
# strip. The landing page beside it (site/index.html) IS committed; only this
# generated subdirectory is not.
/site/case-study/
