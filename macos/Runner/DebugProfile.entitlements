<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- Debug only: the Flutter tooling connects over a local socket.
	     Deliberately NOT present in Release.entitlements. -->
	<key>com.apple.security.network.server</key>
	<true/>

	<!-- Mirrors Release.entitlements so a debug run exercises the same
	     permissions as a release build. See that file for the keychain reasoning. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
