{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://khazana.app/contracts/events/khazana.identity.session-ended.v1.json",
  "title": "SessionEndedV1",
  "description": " A device's session ended in Identity (logout, log out everywhere, a reused refresh token). Devices & Keys revokes the device and drops its key envelope. ",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string",
      "format": "uuid"
    },
    "deviceId": {
      "type": "string",
      "format": "uuid"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "userId",
    "deviceId",
    "at"
  ],
  "additionalProperties": false
}
