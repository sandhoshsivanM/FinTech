  "components": {
    "schemas": {
      "Offer": {
        "required": [
          "id",
          "issuer",
          "network",
          "product",
          "merchant",
          "category",
          "benefit",
          "value",
          "cap",
          "valid_from",
          "valid_to",
          "source",
          "verified_on"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "issuer": {
            "type": [
              "null",
              "string"
            ]
          },
          "network": {
            "type": [
              "null",
              "string"
            ]
          },
          "product": {
            "type": [
              "null",
              "string"
            ]
          },
          "merchant": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "benefit": {
            "type": "string"
          },
          "value": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "cap": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "valid_from": {
            "type": "string",
            "format": "date"
          },
          "valid_to": {
            "type": "string",
            "format": "date"
          },
          "source": {
            "type": "string"
          },
          "verified_on": {
            "type": "string",
            "format": "date"
          }
        },
        "additionalProperties": false
      },
      "ParserTemplate": {
        "required": [
          "id",
          "bank",
          "channel",
          "sender_patterns",
          "rule_json",
          "version"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "bank": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "sender_patterns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rule_json": {
            "type": "string"
          },
          "version": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        },
        "additionalProperties": false
