  "components": {
    "schemas": {
      "ApprovePairing": {
        "required": [
          "code",
          "envelope"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "envelope": {
            "$ref": "#/components/schemas/EnvelopeDto"
          }
        },
        "additionalProperties": false
      },
      "Bootstrap": {
        "required": [
          "device",
          "recovery",
          "key_check"
        ],
        "type": "object",
        "properties": {
          "device": {
            "$ref": "#/components/schemas/EnvelopeDto"
          },
          "recovery": {
            "$ref": "#/components/schemas/EnvelopeDto"
          },
          "key_check": {
            "type": "string",
            "format": "byte"
          }
        },
        "additionalProperties": false
      },
      "EnvelopeDto": {
        "required": [
          "wrapped_dek",
          "alg",
          "key_version"
        ],
        "type": "object",
        "properties": {
          "wrapped_dek": {
            "type": "string",
            "format": "byte"
          },
          "alg": {
            "type": "string"
          },
          "key_version": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "ProvenEnvelope": {
        "required": [
          "envelope",
          "key_check"
        ],
        "type": "object",
        "properties": {
          "envelope": {
            "$ref": "#/components/schemas/EnvelopeDto"
          },
          "key_check": {
            "type": "string",
            "format": "byte"
          }
        },
        "additionalProperties": false
      },
      "RegisterDevice": {
        "required": [
          "platform",
          "public_key"
        ],
        "type": "object",
        "properties": {
          "platform": {
            "type": "string"
          },
          "public_key": {
            "type": "string",
            "format": "byte"
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "app_version": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "additionalProperties": false
      },
      "RenameDevice": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
