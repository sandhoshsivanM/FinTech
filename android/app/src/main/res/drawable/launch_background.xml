<?xml version="1.0" encoding="utf-8"?>
<!-- Launch splash (Android 11 and below; Android 12+ uses the system splash
     configured in values-v31/styles.xml). Canvas colour plus the centred brand
     mark. `splash_mark` and `launch_background` both have night variants.
     Both copies of this file are kept identical (minSdk is 24). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_mark" />
    </item>
</layer-list>
