<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon (Android 8+). Without this the launcher takes the square
  ic_launcher.png and crops it to whatever mask the device uses, which cut the
  corners off the plate and, on a circular mask, clipped the hexagon's rim.

  The background is the flat Vault plate and the foreground is the mark alone,
  so the system can move the two independently for its parallax effect.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
