<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon (Android 8+), generated layers from webapp/scripts/gen-icons.mjs.

  Background: flat white, matching the plated app icons. Foreground: the brand
  mark on transparency, fitted inside the 66dp safe zone of the 108dp canvas so
  no mask shape clips it. Monochrome: a single-colour silhouette of the mark
  that Android 13+ tints for themed icons (it must NOT be the colour foreground).
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>
