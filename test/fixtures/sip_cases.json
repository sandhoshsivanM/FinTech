    {
      "fn": "sipMix",
      "today": "2026-11-23",
      "expect": {
        "rows": [
          {
            "group": "equity",
            "amount": "26100",
            "sipPct": 87,
            "targetPct": 60
          },
          {
            "group": "gold",
            "amount": "4000",
            "sipPct": 13,
            "targetPct": 10
          }
        ],
        "warning": "equity"
      }
    }
  ]
}
