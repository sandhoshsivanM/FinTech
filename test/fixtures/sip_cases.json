{
  "_comment": [
    "Shared parity cases for the SIP schedule. Dates are YYYY-MM-DD calendar dates.",
    "Loaded by test/unit/sip_schedule_test.dart and webapp/src/domain/sip.test.ts; the __fixtures__ copy must stay byte-identical.",
    "The step-up lands every 1 April after the start date."
  ],
  "plans": [
    {
      "id": "ppfas",
      "assetType": "equity_mf",
      "amount": "8000",
      "dayOfMonth": 23,
      "startDate": "2025-01-23",
      "stepUpPct": 0,
      "active": true
    },
    {
      "id": "hdfc",
      "assetType": "equity_mf",
      "amount": "10000",
      "dayOfMonth": 25,
      "startDate": "2024-06-25",
      "stepUpPct": 10,
      "active": true
    },
    {
      "id": "nifty",
      "assetType": "equity_etf",
      "amount": "6000",
      "dayOfMonth": 1,
      "startDate": "2026-01-01",
      "stepUpPct": 0,
      "active": true
    },
    {
      "id": "gold",
      "assetType": "gold_etf",
      "amount": "4000",
      "dayOfMonth": 31,
      "startDate": "2026-12-05",
      "stepUpPct": 0,
      "active": true
    },
    {
      "id": "paused",
      "assetType": "debt_mf",
      "amount": "5000",
      "dayOfMonth": 10,
      "startDate": "2025-05-10",
      "stepUpPct": 0,
      "active": false
    }
  ],
  "instalments": [
    {
      "sipId": "ppfas",
      "dueDate": "2026-10-23",
      "status": "done",
      "amount": "8000"
    },
    {
      "sipId": "hdfc",
      "dueDate": "2026-10-25",
      "status": "done",
      "amount": "12100"
    },
    {
      "sipId": "hdfc",
      "dueDate": "2026-04-25",
      "status": "done",
      "amount": "12100"
    },
    {
      "sipId": "hdfc",
      "dueDate": "2026-03-25",
      "status": "done",
      "amount": "11000"
    },
    {
      "sipId": "nifty",
      "dueDate": "2026-11-01",
      "status": "skipped",
      "amount": "0"
    }
