    {
      "fn": "pendingDue",
      "plan": "nifty",
      "today": "2026-11-23",
      "expect": []
    },
    {
      "fn": "pendingDue",
      "plan": "paused",
      "today": "2026-11-23",
      "expect": []
    },
    {
      "fn": "pendingDue",
      "plan": "gold",
      "today": "2026-11-23",
      "expect": []
    },
    {
      "fn": "nextDue",
      "plan": "ppfas",
      "today": "2026-11-23",
      "expect": "2026-12-23"
    },
    {
      "fn": "nextDue",
      "plan": "hdfc",
      "today": "2026-11-23",
      "expect": "2026-11-25"
    },
    {
      "fn": "nextDue",
      "plan": "gold",
      "today": "2026-11-23",
      "expect": "2026-12-31"
    },
    {
      "fn": "nextDue",
      "plan": "gold",
      "today": "2027-01-31",
      "expect": "2027-02-28"
    },
    {
      "fn": "nextDue",
      "plan": "paused",
      "today": "2026-11-23",
      "expect": null
    },
    {
      "fn": "monthlyTotal",
      "today": "2026-11-23",
      "expect": "30100"
    },
    {
      "fn": "investedThisFy",
      "today": "2026-11-23",
      "expect": "32200"
    },
    {
      "fn": "unitsFor",
      "amount": "5000",
      "nav": "96.42",
      "expect": "51.856"
    },
    {
      "fn": "unitsFor",
      "amount": "8000",
      "nav": "74.3109",
      "expect": "107.656"
    },
    {
      "fn": "monthsToClose",
      "gap": "60000",
      "monthly": "5000",
      "expect": 12
    },
    {
      "fn": "monthsToClose",
      "gap": "60001",
      "monthly": "5000",
      "expect": 13
