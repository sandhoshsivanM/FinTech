      "expect": [
        "2026-12-31",
        "2027-01-31",
        "2027-02-28",
        "2027-03-31"
      ]
    },
    {
      "fn": "occurrences",
      "plan": "ppfas",
      "from": "2026-08-01",
      "to": "2026-11-23",
      "expect": [
        "2026-08-23",
        "2026-09-23",
        "2026-10-23",
        "2026-11-23"
      ]
    },
    {
      "fn": "amountOn",
      "plan": "hdfc",
      "on": "2025-03-31",
      "expect": "10000"
    },
    {
      "fn": "amountOn",
      "plan": "hdfc",
      "on": "2025-04-01",
      "expect": "11000"
    },
    {
      "fn": "amountOn",
      "plan": "hdfc",
      "on": "2026-11-23",
      "expect": "12100"
    },
    {
      "fn": "amountOn",
      "plan": "hdfc",
      "on": "2027-04-25",
      "expect": "13310"
    },
    {
